#include <iostream>
using namespace std;

class Rectangle
{
    int length, width;

public:
    // Constructor
    Rectangle(int l, int w)
    {
        length = l;
        width = w;
    }

    // Function to display details and area
    void display()
    {
        cout << "\nLength: " << length;
        cout << "\nWidth: " << width;
        cout << "\nArea: " << length * width;
    }
};

int main()
{
    int l, w;

    cout << "Enter length: ";
    cin >> l;

    cout << "Enter width: ";
    cin >> w;

    // Object creation
    Rectangle r(l, w);

    r.display();

    return 0;
}
    



